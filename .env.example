# Copia este fichero como .env y rellena los valores. El .env nunca se versiona.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# ID de la base de datos de tareas de Notion del equipo (pídelo junto con las credenciales)
NOTION_TASKS_DATABASE_ID=
# Solo si usas Claude Code con una carpeta de configuración propia (otra cuenta), p. ej. C:\Users\tu\.claude-empresa
CLAUDE_CONFIG_DIR=
